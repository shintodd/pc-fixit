# ==============================================================================
# pcfix Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# Used by docker-compose.yml to spin up the local PostgreSQL container
# ------------------------------------------------------------------------------
POSTGRES_DB=pcfix
POSTGRES_USER=pcfix_admin
POSTGRES_PASSWORD=replace_with_strong_password

# ------------------------------------------------------------------------------
# 2. Database URL (Prisma ORM Connection String)
# Note: The application degrades gracefully to static research data if
# PostgreSQL is unreachable or not yet migrated.
#
# Option A: When connecting from local host (Prisma CLI, local Next.js):
DATABASE_URL=postgresql://pcfix_admin:replace_with_strong_password@127.0.0.1:5432/pcfix?schema=public&connection_limit=15&pool_timeout=10
#
# Option B: When running inside Docker Compose container network:
# DATABASE_URL=postgresql://pcfix_admin:replace_with_strong_password@postgres:5432/pcfix?schema=public&connection_limit=15&pool_timeout=10

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API Configuration
# Get a free API key from Google AI Studio: https://aistudio.google.com/
# Note: The application operates in offline/local mode if this key is omitted.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 4. Server Network & Port Configuration
# ------------------------------------------------------------------------------
# Application listening port (default: 3000)
PORT=3000

# Application host binding (127.0.0.1 for local host isolation, 0.0.0.0 for Docker containers)
HOSTNAME=127.0.0.1

# ------------------------------------------------------------------------------
# 5. Public Site URL
# Base URL used for metadata, OpenGraph cards, and canonical link generation.
# Set to your Cloudflare tunnel domain or custom production domain.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
