generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Source {
  researched
  verified
  live_search
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  severity    String   // "info" | "warn" | "critical"
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([severity])
  @@map("categories")
}

model Issue {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  summary       String
  severity      String      // "info" | "warn" | "critical"
  symptoms      String[]
  fix_steps     Json        // Array of { title: string, detail: string }
  source        Source      @default(researched)
  verified      Boolean     @default(false)
  category_slug String?
  category      Category?   @relation(fields: [category_slug], references: [slug])
  error_codes   ErrorCode[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([category_slug])
  @@index([category_slug, severity])
  @@index([severity])
  @@index([verified, source])
  @@index([source, verified])
  @@map("issues")
}

model ErrorCode {
  id          Int      @id @default(autoincrement())
  code        Int      @unique
  name        String
  explanation String
  fix_guide   String
  source      Source   @default(researched)
  verified    Boolean  @default(false)
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([verified, source])
  @@index([source, verified])
  @@map("error_codes")
}

model WizardNode {
  id        String   @id
  question  String
  options   Json     // Array of { label: string, next_id: string | null, resolves_to_issue_slug?: string | null }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("wizard_nodes")
}

enum ComponentType {
  CPU
  GPU
  MOTHERBOARD
  RAM
  STORAGE
  PSU
  CASE
  COOLER
}

model Part {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  brand          String
  model          String
  type           ComponentType
  specs          Json
  benchmarkScore Int             @default(0)
  imageUrl       String?
  prices         PartPrice[]
  priceHistory   PriceHistory[]
  watchlists     PartWatchlist[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([type])
  @@index([brand])
  @@index([type, benchmarkScore])
  @@map("parts")
}

model Retailer {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  websiteUrl    String
  logoUrl       String?
  isActive      Boolean        @default(true)
  isMarketplace Boolean        @default(false)
  prices        PartPrice[]
  priceHistory  PriceHistory[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("retailers")
}

model PartPrice {
  id               String   @id @default(cuid())
  partId           String
  part             Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  retailerId       String
  retailer         Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  priceMyr         Decimal  @db.Decimal(10, 2)
  originalPriceMyr Decimal? @db.Decimal(10, 2)
  condition        String   @default("new")
  sellerLocation   String?
  inStock          Boolean  @default(true)
  stockQuantity    Int?
  productUrl       String
  affiliateUrl     String?
  sku              String?
  lastScrapedAt    DateTime @default(now())

  @@unique([partId, retailerId, condition])
  @@index([partId, priceMyr])
  @@index([retailerId])
  @@index([condition])
  @@map("part_prices")
}

model PriceHistory {
  id         String   @id @default(cuid())
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  priceMyr   Decimal  @db.Decimal(10, 2)
  condition  String   @default("new")
  inStock    Boolean  @default(true)
  recordedAt DateTime @default(now())

  @@index([partId, recordedAt])
  @@index([condition])
  @@map("price_histories")
}

model PartWatchlist {
  id             String    @id @default(cuid())
  userEmail      String
  partId         String
  part           Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  targetPriceMyr Decimal   @db.Decimal(10, 2)
  notifyChannel  String    @default("in_app")
  webhookUrl     String?
  isActive       Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([partId, isActive])
  @@index([userEmail])
  @@map("part_watchlists")
}

model SavedBuild {
  id                  String   @id @default(cuid())
  title               String
  description         String?
  budgetMyr           Decimal  @db.Decimal(10, 2)
  useCase             String
  parts               Json
  totalPriceMyr       Decimal  @db.Decimal(10, 2)
  isCompatible        Boolean  @default(true)
  compatibilityReport Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("saved_builds")
}

model InstallationGuide {
  id               String        @id @default(cuid())
  componentType    ComponentType @unique
  title            String
  summary          String
  difficulty       String
  estimatedMinutes Int
  videoEmbedUrl    String?
  toolsNeeded      String[]
  precautions      String[]
  steps            Json
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("installation_guides")
}


